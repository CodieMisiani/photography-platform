# Copy this file to server/.env locally or set these values in Railway.
# Never commit server/.env or real production secrets.

NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://user:password@host:5432/photography_platform
REDIS_URL=redis://default:password@host:6379
SESSION_COOKIE_NAME=studio_admin_session
SESSION_SECRET=replace-with-a-long-random-secret
COOKIE_SECURE=false

# Admin credentials are used only by the seed script.
# Replace these securely in your local shell or deployment dashboard before running the seed.
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=change-this-before-running-seed
ADMIN_PASSWORD_HASH=$2b$12$replace_with_bcrypt_hash

# Cloudinary
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
CLOUDINARY_FOLDER=malume-photography

# Newsletter email notifications
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=notifications@example.com
SMTP_PASS=replace-with-smtp-password
SMTP_FROM="Malume Photography <notifications@example.com>"
SMTP_SECURE=false
NEWSLETTER_NOTIFY_EMAIL=nimrodmisiani42@gmail.com

# Provider-neutral notifications
EMAIL_PROVIDER=gmail
GMAIL_USER=your-gmail@gmail.com
GMAIL_APP_PASSWORD=your-16-character-app-password
WHATSAPP_PROVIDER=baileys
BAILEYS_SESSION_PATH=./baileys-session

# Daraja / M-Pesa
DARAJA_ENV=sandbox
DARAJA_CONSUMER_KEY=your-consumer-key
DARAJA_CONSUMER_SECRET=your-consumer-secret
DARAJA_PASSKEY=your-passkey
DARAJA_SHORTCODE=your-paybill-or-till
DARAJA_CALLBACK_URL=https://your-api-domain.railway.app/webhooks/daraja
DARAJA_CURRENCY=KES

# Business placeholders - replace before go-live.
BUSINESS_NAME=Malume Photography
BUSINESS_PHONE=+254726304245
BUSINESS_EMAIL=hello@malumephotography.com
